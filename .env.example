# Copy this file to runtime-data/.env and fill in your own credentials.
# Never commit runtime-data/.env.

# Required: DeepSeek OpenAI-compatible API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONING_EFFORT=high

# Optional: Bocha web search
BOCHA_SEARCH_API_KEY=
BOCHA_SEARCH_URL=https://api.bocha.cn/v1/web-search
BOCHA_SEARCH_TIMEOUT_SECONDS=15
BOCHA_SEARCH_FRESHNESS=noLimit
BOCHA_SEARCH_SUMMARY=true
BOCHA_SEARCH_INCLUDE=
BOCHA_SEARCH_EXCLUDE=

# Local retrieval
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
QDRANT_COLLECTION=general_docs_v2

# Bounded agent runtime
MAX_PLAN_STEPS=5
MAX_TOOL_CALLS=6
MAX_REPLAN_COUNT=2
MAX_WEB_SEARCH_CALLS=3
MAX_LLM_CALLS=12
MAX_RUN_TOKENS=24000
MAX_RUN_DURATION_SECONDS=900
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_SECONDS=1
LLM_RATE_LIMIT_PER_SECOND=3
BOCHA_RATE_LIMIT_PER_SECOND=2
WEB_SEARCH_CACHE_TTL_SECONDS=300
EMBEDDING_CACHE_TTL_SECONDS=604800

# Optional read-only filesystem MCP. Leave empty to disable.
MCP_FILESYSTEM_ROOT=
MCP_TIMEOUT_SECONDS=15

# Background worker and bounded multi-agent research
BACKGROUND_WORKER_COUNT=2
MAX_WORKER_RECOVERIES=1
MAX_AGENTS=4
MAX_SUBTASKS=4
MAX_RESEARCH_ROUNDS=2
MAX_CRITIC_ROUNDS=2
MAX_TOTAL_TOOL_CALLS=8

# Optional MCP stdio server. Prefer the JSON array form on Windows.
MCP_STDIO_COMMAND=
MCP_STDIO_COMMAND_JSON=
MCP_STDIO_SERVER_NAME=stdio
MCP_STDIO_CWD=
